# Base URL of produit-api's REST API. The MAIN_VITE_ prefix is required by
# electron-vite for this variable to reach the main process — see
# electron/main/powersync/README.md. Used by
# electron/main/powersync/connector.ts both to upload local changes and to
# fetch a short-lived PowerSync JWT from POST ${MAIN_VITE_API_URL}/auth/token.
# The PowerSync instance URL itself is not configured here — produit-api
# returns it in that same call, so there's no separate PowerSync URL/token
# pair to keep in sync on the desktop side anymore.
MAIN_VITE_API_URL="http://localhost:3000/api"

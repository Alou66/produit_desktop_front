{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Application Desktop de gestion - socle technique Electron + React + TypeScript + Vite",
  "author": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "unset ELECTRON_RUN_AS_NODE; electron-vite dev -- --ozone-platform=x11",
    "build": "electron-vite build",
    "preview": "unset ELECTRON_RUN_AS_NODE; electron-vite preview -- --ozone-platform=x11",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "db:inspect": "ELECTRON_RUN_AS_NODE=1 electron scripts/db-inspect.cjs",
    "dist": "electron-vite build && electron-builder --publish=never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish=never",
    "dist:win": "electron-vite build && electron-builder --win --publish=never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish=never"
  },
  "dependencies": {
    "@powersync/node": "^0.20.2",
    "@radix-ui/react-slot": "^1.3.3",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
